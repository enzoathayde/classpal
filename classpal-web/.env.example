# ============================================================
# Backend switch: spring | sheets
# ============================================================
VITE_API_BACKEND=sheets

# --- spring (Java API) ---
# VITE_API_BACKEND=spring
# VITE_USUARIOS_URL=http://localhost:8080
# VITE_ALUNOS_URL=http://localhost:8080

# --- sheets (Google Apps Script) ---
# Server-only (local proxy + Vercel). NEVER use VITE_ prefix for these.
APPS_SCRIPT_URL=https://script.google.com/macros/s/SEU_DEPLOYMENT_ID/exec
APPS_SCRIPT_SECRET=seu_app_secret_do_setup

# Optional override (default = same origin /api via Vite proxy or Vercel)
# VITE_SHEETS_API_URL=
